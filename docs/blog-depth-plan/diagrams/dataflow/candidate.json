      "variant": "emphasis",
      "labelDy": -28
    },
    {
      "from": "duck",
      "to": "batch",
      "label": "export batch",
      "variant": "emphasis",
      "labelDy": -28
    },
    {
      "from": "batch",
      "to": "adapter",
      "label": "upload parts",
      "variant": "emphasis",
      "labelDy": -28
    },
    {
      "from": "adapter",
      "to": "catalog",
      "label": "ingest + publish",
      "variant": "emphasis",
      "labelDy": 25
    },
    {
      "from": "catalog",
      "to": "managed",
      "label": "commit data",
      "variant": "emphasis"
    },
    {
      "from": "managed",
      "to": "readers",
      "label": "read tables",
      "variant": "emphasis",
      "labelDy": 25
    },
    {
      "from": "duck",
      "to": "journal",
