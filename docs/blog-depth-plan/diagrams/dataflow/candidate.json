      "label": "Platform adapter"
    },
    {
      "label": "Managed lakehouse"
    }
  ],
  "nodes": [
    {
      "id": "files",
      "type": "external",
      "label": "Local files",
      "sublabel": "CSV / JSON / Parquet",
      "stage": 0,
      "row": 0,
      "width": 144
    },
    {
      "id": "duck",
      "type": "database",
      "label": "DuckDB",
      "sublabel": "embedded SQL engine",
      "stage": 1,
      "row": 0,
      "width": 144
    },
    {
      "id": "batch",
      "type": "database",
