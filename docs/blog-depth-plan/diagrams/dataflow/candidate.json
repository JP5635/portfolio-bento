      "label": "reconcile",
      "variant": "dashed"
    },
    {
      "from": "inspect",
      "to": "catalog",
      "label": "verify commit",
      "variant": "dashed",
      "labelDy": -28
    },
    {
      "from": "catalog",
      "to": "journal",
      "label": "record outcome",
      "variant": "dashed",
      "route": "bottom-channel",
      "fromSide": "bottom",
      "toSide": "bottom",
      "channelY": 480,
      "labelAt": [
        530,
        468
      ]
    }
