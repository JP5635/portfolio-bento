  "cards": [
    {
      "dot": "cyan",
      "title": "Reference design, not a private deployment",
      "items": [
        "Generic components show separate gates: staging upload, platform table commit and query freshness.",
        "The client uploads through a platform adapter; it does not write directly to managed lakehouse storage."
      ]
    },
    {
      "dot": "amber",
      "title": "Two different snapshots",
      "items": [
        "A DuckDB transaction snapshot protects a local read view.",
        "Lakehouse snapshots belong to the table format and catalog; verify support in the adapter.",
        "OCI uses an S3-compatible provider path; adapter support must be verified per deployment."
      ]
    },
    {
      "dot": "emerald",
      "title": "Reconcile observable state",
      "items": [
        "Persist stable batch identities and checkpoints; verify committed batches individually.",
        "An earlier batch can be queryable before a full file finishes. Application convergence is separate from object store consistency."
      ]
    }
  ]
}
